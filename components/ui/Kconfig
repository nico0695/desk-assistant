menu "Desk Assistant UI"

    config UI_TASK_STACK_SIZE
        int "UI task stack size (bytes)"
        range 4096 16384
        default 6144

    config UI_TASK_PRIORITY
        int "UI task priority"
        range 1 20
        default 4

    config UI_DIAGNOSTICS_PERIOD_S
        int "UI diagnostics period (seconds)"
        depends on DESK_MEMORY_DIAGNOSTICS
        range 10 3600
        default 60
        help
            Period of the UI report: task wakeups since the previous report, LVGL pool
            usage and the memory checkpoint.

endmenu
