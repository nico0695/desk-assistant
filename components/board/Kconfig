menu "Desk Assistant board"

    config BOARD_DISPLAY_BUFFER_ROWS
        int "Rows per display draw buffer"
        range 2 480
        default 10
        help
            Height of each partial draw buffer. Must be even so updates stay on the
            panel's 2x2 grid.

    config BOARD_DISPLAY_BUFFER_COUNT
        int "Number of display draw buffers"
        range 1 2
        default 2
        help
            Two buffers let rendering overlap the transfer of the previous one.

    config BOARD_AUDIO_DMA_DESC_COUNT
        int "Audio capture DMA descriptors"
        range 2 16
        default 6
        help
            Each descriptor holds one block of 256 samples (16 ms at 16 kHz). They absorb
            the moments when flash writes pause the reading task.

    config BOARD_BATTERY_READ_PERIOD_S
        int "Battery reading period (seconds)"
        range 5 600
        default 30

    config BOARD_AUDIO_ACQUIRE_WAIT_MS
        int "Capture wait for a finishing tone in milliseconds"
        range 100 5000
        default 1000

    config BOARD_BATTERY_TASK_STACK_SIZE
        int "Battery task stack size (bytes)"
        range 1536 8192
        default 2048

    config BOARD_BATTERY_TASK_PRIORITY
        int "Battery task priority"
        range 1 10
        default 2

endmenu
